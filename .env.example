DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_journal
PORT=3001
# Optional: set a stable UUID per authenticated user when adding authentication.
JOURNAL_USER_ID=00000000-0000-4000-8000-000000000001
JOURNAL_USER_NAME=My Trading Journal
# Set PGSSL=true when connecting to a hosted PostgreSQL service requiring SSL.
PGSSL=false
