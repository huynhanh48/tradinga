---
import { convertPathToHtml } from "../../../utils/index.js"
const { path, page } = Astro.props
const htmlPath = convertPathToHtml(path);

// Smart path resolution: calculate relative path based on directory depth
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(segment => segment !== '');
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0;
const deploymentPath = depth === 0 ? './' : '../'.repeat(depth);
---

<!--begin::Sidebar-->
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <!--begin::Sidebar Brand-->
  <div class="sidebar-brand">
    <!--begin::Brand Link-->
    <a href={htmlPath === "." ? "./" : htmlPath + "/"} class="brand-link">
      <!--begin::Brand Image-->
      <img
        src={deploymentPath + "assets/img/AdminLTELogo.png"}
        alt="TradingA Logo"
        class="brand-image opacity-75 shadow"
      />
      <!--end::Brand Image-->
      <!--begin::Brand Text-->
      <span class="brand-text fw-bold">TradingA</span>
      <!--end::Brand Text-->
    </a>
    <!--end::Brand Link-->
  </div>
  <!--end::Sidebar Brand-->
  <!--begin::Sidebar Search-->
  <div class="sidebar-search" role="search">
    <label for="sidebar-search-input" class="visually-hidden">Filter menu</label>
    <input
      type="search"
      id="sidebar-search-input"
      class="form-control form-control-sm"
      placeholder="Filter menu…"
      autocomplete="off"
      data-lte-toggle="sidebar-search"
      data-lte-target="#navigation"
    />
    <p
      class="fs-7 text-secondary mt-2 mb-0"
      data-lte-search-empty
      role="status"
      hidden
    >
      No matching pages.
    </p>
  </div>
  <!--end::Sidebar Search-->
  <!--begin::Sidebar Wrapper-->
  <div class="sidebar-wrapper">
    <nav class="mt-2" aria-label="Main navigation">
      <!--begin::Sidebar Menu-->
      <ul
        class="nav sidebar-menu flex-column"
        data-lte-toggle="treeview"
        data-accordion="false"
        id="navigation"
      >
        <!-- Main Trading Navigation -->
        <li class="nav-header">TRADING JOURNAL</li>
        <li class="nav-item">
          <a
            href={htmlPath === "." ? "./" : htmlPath + "/"}
            class:list={["nav-link", page === "dashboard" && "active"]}
          >
            <i class="nav-icon bi bi-speedometer2"></i>
            <p>Dashboard</p>
          </a>
        </li>
        <li class="nav-item">
          <a
            href={htmlPath + "/weekly-calendar.html"}
            class:list={["nav-link", (page === "weekly-calendar" || page === "trading-journal") && "active"]}
          >
            <i class="nav-icon bi bi-calendar3"></i>
            <p>Weekly Calendar</p>
          </a>
        </li>
        <li class="nav-item">
          <a
            href={htmlPath + "/reports.html"}
            class:list={["nav-link", page === "reports" && "active"]}
          >
            <i class="nav-icon bi bi-bar-chart-line"></i>
            <p>Periodic Reports</p>
          </a>
        </li>
        <li class="nav-item">
          <a
            href={htmlPath + "/activity-calendar.html"}
            class:list={["nav-link", page === "activity-calendar" && "active"]}
          >
            <i class="nav-icon bi bi-calendar2-week"></i>
            <p>Activity Calendar</p>
          </a>
        </li>
        <li class="nav-item">
          <a
            href={htmlPath + "/accounts.html"}
            class:list={["nav-link", page === "accounts" && "active"]}
          >
            <i class="nav-icon bi bi-person-badge"></i>
            <p>Trading Accounts</p>
          </a>
        </li>
      </ul>
      <!--end::Sidebar Menu-->
    </nav>
  </div>
  <!--end::Sidebar Wrapper-->
</aside>
<!--end::Sidebar-->
