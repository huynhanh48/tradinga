---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "Trading Dashboard | TradingA"
const path = "../../dist"
const page = "dashboard"
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} path={path} />
    <meta
      name="description"
      content="Overview and analytics dashboard for Trading Journal."
    />
    <style is:global>
      .journal-chart {
        width: 100%;
        min-height: 380px;
      }
      .journal-status {
        min-height: 1.5rem;
      }
      .small-box {
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .small-box:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
      }
      .small-box .inner {
        padding: 1.25rem 1.15rem 0.75rem !important;
      }
      .small-box .inner h3 {
        font-size: 1.95rem !important;
        font-weight: 700 !important;
        letter-spacing: -0.5px;
        margin-bottom: 0.25rem !important;
      }
      .small-box .inner p {
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        opacity: 0.88;
      }
      .small-box-icon {
        font-size: 4.25rem !important;
        opacity: 0.3 !important;
      }
      #dashboard-efficiency-rows td {
        padding-top: 1.05rem;
        padding-bottom: 1.05rem;
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row align-items-center">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Trading Performance Overview</h1>
              </div>
              <div class="col-sm-6">
                <div class="d-flex align-items-center justify-content-sm-end gap-2 mt-2 mt-sm-0">
                  <!-- Account Selector (Multi-Profile) -->
                  <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-primary text-white">
                      <i class="bi bi-person-circle"></i>
                    </span>
                    <select class="form-select fw-semibold" id="account-selector" aria-label="Select Trading Account">
                      <option value="00000000-0000-4000-8000-000000000001">Primary Account</option>
                    </select>
                  </div>
                  <nav aria-label="Breadcrumb" class="d-none d-md-block">
                    <ol class="breadcrumb mb-0">
                      <li class="breadcrumb-item"><a href="./">Trading Journal</a></li>
                      <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="app-content">
          <div class="container-fluid">
            <div
              class="journal-status small mb-2"
              id="status-message"
              role="status"
              aria-live="polite"
            ></div>

            <!-- Filter Toolbar -->
            <div class="card shadow-sm border mb-3">
              <div class="card-body py-2">
                <div class="d-flex flex-wrap align-items-end gap-2">
                  <div>
                    <label class="form-label fw-semibold small mb-1" for="dashboard-period">
                      Period
                    </label>
                    <select class="form-select form-select-sm" id="dashboard-period">
                      <option value="week" selected>Week</option>
                      <option value="month">Month</option>
                      <option value="quarter">Quarter</option>
                      <option value="year">Year</option>
                    </select>
                  </div>
                  <div>
                    <label class="form-label fw-semibold small mb-1" for="dashboard-date">
                      Timeline
                    </label>
                    <input class="form-control form-control-sm" type="date" id="dashboard-date" />
                  </div>
                  <button class="btn btn-sm btn-primary" type="button" id="dashboard-load">
                    <i class="bi bi-funnel me-1"></i> Apply Filter
                  </button>
                </div>
              </div>
            </div>

            <!-- Small Box Widgets (KPIs) -->
            <div class="row g-3" id="dashboard-summary"></div>

            <!-- Charts Section & Efficiency Breakdown -->
            <div class="row g-3 mt-1">
              <div class="col-12 col-xl-8">
                <div class="card shadow-sm border mb-0 h-100">
                  <div class="card-header bg-body d-flex justify-content-between align-items-center">
                    <h2 class="card-title fw-bold fs-5 mb-0">Cumulative PnL &amp; Growth Curve</h2>
                    <span class="badge text-bg-primary ms-auto">Pips Growth Line</span>
                  </div>
                  <div class="card-body">
                    <svg
                      id="dashboard-chart"
                      class="journal-chart"
                      role="img"
                      aria-label="Pips performance chart"
                    ></svg>
                  </div>
                </div>
              </div>
              <div class="col-12 col-xl-4">
                <!-- Simple Table: Performance Breakdown -->
                <div class="card shadow-sm border mb-0 h-100">
                  <div class="card-header bg-body">
                    <h2 class="card-title fw-bold fs-5 mb-0">Performance Efficiency</h2>
                  </div>
                  <div class="card-body p-0">
                    <table class="table table-striped table-valign-middle mb-0">
                      <thead>
                        <tr>
                          <th>Metric</th>
                          <th>Value</th>
                          <th>Assessment</th>
                        </tr>
                      </thead>
                      <tbody id="dashboard-efficiency-rows">
                        <!-- Dynamically filled by trading-journal.ts -->
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Weekly Performance Comparison Section on Dashboard -->
            <div class="card my-3 shadow-sm border" id="weekly-comparison-card">
              <div class="card-header bg-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h2 class="card-title fw-bold fs-5 mb-0">
                  <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Weekly Performance Comparison
                </h2>
              </div>
              <div class="card-body">
                <!-- Comparison KPI summary cards -->
                <div class="row g-3 mb-3" id="weekly-compare-kpis">
                  <div class="col-6 col-md-3">
                    <div class="p-3 rounded border bg-body-tertiary">
                      <div class="small text-secondary fw-semibold mb-1">Most Recent Week</div>
                      <div class="fs-5 fw-bold text-success" id="wc-kpi-current-pips">+0.00 Pips</div>
                      <div class="small text-muted" id="wc-kpi-current-winrate">Win Rate: —</div>
                    </div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="p-3 rounded border bg-body-tertiary">
                      <div class="small text-secondary fw-semibold mb-1">vs Prior Week</div>
                      <div class="fs-5 fw-bold text-primary" id="wc-kpi-diff-pips">—</div>
                      <div class="small text-muted" id="wc-kpi-diff-winrate">—</div>
                    </div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="p-3 rounded border bg-body-tertiary">
                      <div class="small text-secondary fw-semibold mb-1">Best Performing Week</div>
                      <div class="fs-5 fw-bold text-success" id="wc-kpi-best-week">—</div>
                      <div class="small text-muted" id="wc-kpi-best-label">—</div>
                    </div>
                  </div>
                  <div class="col-6 col-md-3">
                    <div class="p-3 rounded border bg-body-tertiary">
                      <div class="small text-secondary fw-semibold mb-1">Weekly Average</div>
                      <div class="fs-5 fw-bold text-dark" id="wc-kpi-avg-pips">+0.00 Pips</div>
                      <div class="small text-muted" id="wc-kpi-avg-trades">—</div>
                    </div>
                  </div>
                </div>

                <!-- Two Comparison Charts -->
                <div class="row g-3">
                  <div class="col-12 col-lg-7">
                    <div class="card shadow-none border mb-0">
                      <div class="card-header bg-body py-2 d-flex justify-content-between align-items-center">
                        <span class="fw-semibold small">Net Pips by Week</span>
                      </div>
                      <div class="card-body p-2">
                        <svg
                          id="weekly-compare-pips-chart"
                          class="journal-chart"
                          style="height: 190px; width: 100%;"
                          role="img"
                          aria-label="Weekly net pips comparison chart"
                        ></svg>
                      </div>
                    </div>
                  </div>
                  <div class="col-12 col-lg-5">
                    <div class="card shadow-none border mb-0">
                      <div class="card-header bg-body py-2 d-flex justify-content-between align-items-center">
                        <span class="fw-semibold small">Win Rate Trend (%)</span>
                        <span class="badge text-bg-light border text-secondary small">Trendline &amp; 50% Benchmark</span>
                      </div>
                      <div class="card-body p-2">
                        <svg
                          id="weekly-compare-winrate-chart"
                          class="journal-chart"
                          style="height: 190px; width: 100%;"
                          role="img"
                          aria-label="Weekly win rate trend chart"
                        ></svg>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </main>
      <Footer />
    </div>

    <Scripts path={path} />
    <script src="../scripts/trading-journal.ts"></script>
  </body>
</html>
