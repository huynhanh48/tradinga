---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "Weekly Trading Calendar | TradingA"
const path = "../../dist"
const page = "weekly-calendar"
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} path={path} />
    <meta
      name="description"
      content="Weekly Pips trading calendar, trade logging, and live weekly statistics."
    />
    <style is:global>
      .journal-toolbar {
        gap: 0.5rem;
      }
      .journal-day {
        min-width: 140px;
        height: 100%;
        background-color: var(--bs-card-bg);
        transition: background-color 0.15s ease-in-out;
      }
      .journal-day.is-today {
        background: color-mix(in srgb, var(--bs-primary) 10%, var(--bs-body-bg));
        border: 1px solid var(--bs-primary) !important;
      }
      .journal-day-heading {
        min-height: 52px;
        padding-bottom: 0.35rem;
        border-bottom: 1px dashed var(--bs-border-color);
      }
      .journal-trades {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-height: 48px;
      }
      .journal-trade {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.25rem;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        background: var(--bs-tertiary-bg);
      }
      .journal-trade-value {
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none !important;
      }
      .journal-trade-value.is-win,
      .journal-positive {
        color: #198754 !important;
      }
      .journal-trade-value.is-loss,
      .journal-negative {
        color: #dc3545 !important;
      }
      .journal-day-total {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        font-size: 1.05rem;
      }
      .journal-total-card {
        border-left: 4px solid var(--bs-primary);
      }
      .journal-stat {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--bs-border-color);
      }
      .journal-stat strong {
        font-variant-numeric: tabular-nums;
        font-size: 1rem;
      }
      .journal-stat:last-child {
        border-bottom: 0;
      }
      .journal-status {
        min-height: 1.5rem;
      }
      .progress-xs {
        height: 7px;
      }
      @media (max-width: 575.98px) {
        .journal-toolbar {
          align-items: stretch !important;
        }
        .journal-toolbar .btn-group {
          width: 100%;
        }
        .journal-toolbar input[type="date"] {
          flex: 1;
        }
      }
      @media print {
        @page {
          size: A4 portrait;
          margin: 8mm;
        }
        html, body {
          background: #fff !important;
          color: #000 !important;
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          height: 100% !important;
          overflow: hidden !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
        }
        /* Hide all UI elements except printable invoice container */
        .app-header,
        .app-sidebar,
        .app-footer,
        .app-content-header,
        .app-content,
        .modal,
        .modal-backdrop {
          display: none !important;
        }
        #invoice-print-container {
          display: block !important;
          position: static !important;
          width: 100% !important;
          margin: 0 !important;
          padding: 0 !important;
        }
        #invoice-print-area {
          display: block !important;
          position: static !important;
          width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
          background: #fff !important;
          color: #000 !important;
          font-size: 9.5pt !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
        #invoice-print-area table {
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
        #invoice-print-area tr {
          page-break-inside: avoid !important;
          break-inside: avoid !important;
        }
      }
    </style>
  </head>
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} page={page} />
      <main class="app-main">
        <div class="app-content-header">
          <div class="container-fluid">
            <div class="row align-items-center">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Weekly Trading Calendar</h1>
              </div>
              <div class="col-sm-6">
                <div class="d-flex align-items-center justify-content-sm-end gap-2 mt-2 mt-sm-0">
                  <!-- Account Selector (Multi-Profile) -->
                  <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-primary text-white">
                      <i class="bi bi-person-circle"></i>
                    </span>
                    <select class="form-select fw-semibold" id="account-selector" aria-label="Select Trading Account">
                      <option value="00000000-0000-4000-8000-000000000001">Primary Account</option>
                    </select>
                  </div>
                  <nav aria-label="Breadcrumb" class="d-none d-md-block">
                    <ol class="breadcrumb mb-0">
                      <li class="breadcrumb-item"><a href="./">Trading Journal</a></li>
                      <li class="breadcrumb-item active" aria-current="page">Weekly Calendar</li>
                    </ol>
                  </nav>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="app-content">
          <div class="container-fluid">
            <div class="card shadow-sm border-0">
              <div class="card-header bg-body border-bottom py-2">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                  <!-- Weekly Toolbar (Date picker only, arrow buttons removed) -->
                  <div class="d-flex align-items-center" id="calendar-header-toolbar">
                    <div class="input-group input-group-sm w-auto shadow-xs">
                      <span class="input-group-text bg-body text-secondary border-end-0">
                        <i class="bi bi-calendar3"></i>
                      </span>
                      <input
                        class="form-control form-control-sm border-start-0 fw-semibold"
                        id="selected-date"
                        type="date"
                        aria-label="Select date in week"
                        style="min-width: 160px;"
                      />
                    </div>
                  </div>

                  <div class="d-flex align-items-center gap-2">
                    <button
                      type="button"
                      class="btn btn-sm btn-outline-primary fw-semibold"
                      id="btn-export-invoice"
                    >
                      <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> Export PDF Report
                    </button>
                    <div
                      class="badge text-bg-light border px-3 py-2 fs-6 fw-bold text-primary"
                      id="week-label"
                      aria-live="polite"
                    ></div>
                  </div>
                </div>
              </div>

              <div class="card-body">
                <div
                  class="journal-status small mb-2"
                  id="status-message"
                  role="status"
                  aria-live="polite"
                ></div>

                <!-- WEEKLY TRADING CALENDAR (EXCEL/PDF TABLE STYLE) -->
                <section
                  id="calendar-view"
                  aria-label="Weekly trading calendar"
                >
                  <div class="row g-3">
                    <div class="col-12 col-xl-9 col-xxl-9">
                      <div
                        class="table-responsive w-100"
                        tabindex="0"
                        aria-label="Scrollable weekly trading calendar"
                      >
                        <table class="table table-bordered align-middle text-center mb-2 shadow-sm w-100" style="table-layout: fixed;">
                          <thead class="table-primary text-primary-emphasis">
                            <tr>
                              <th scope="col" style="width: 14.285%">Monday</th>
                              <th scope="col" style="width: 14.285%">Tuesday</th>
                              <th scope="col" style="width: 14.285%">Wednesday</th>
                              <th scope="col" style="width: 14.285%">Thursday</th>
                              <th scope="col" style="width: 14.285%">Friday</th>
                              <th scope="col" style="width: 14.285%">Saturday</th>
                              <th scope="col" style="width: 14.285%">Sunday</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr id="calendar-days"></tr>
                          </tbody>
                        </table>
                      </div>
                      <div class="card journal-total-card mt-3 mb-0 shadow-sm">
                        <div class="card-body py-2 d-flex justify-content-between align-items-center">
                          <span class="fw-bold fs-6">Weekly Total Pips:</span>
                          <strong id="week-total" class="fs-4">
                            0.00
                          </strong>
                        </div>
                      </div>
                      <div class="mt-3">
                        <label for="weekly-notes" class="form-label fw-semibold">
                          Weekly Review &amp; Lessons
                        </label>
                        <textarea
                          class="form-control"
                          id="weekly-notes"
                          rows="2"
                          maxlength="2000"
                          placeholder="Weekly trade reflections, psychological notes, key lessons learned..."
                        ></textarea>
                        <div
                          class="small text-body-secondary mt-1"
                          id="review-status"
                          aria-live="polite"
                        ></div>
                      </div>
                    </div>

                    <!-- Right Column: Simple Tables with Progress Bars -->
                    <aside class="col-12 col-xl-3 col-xxl-3" aria-label="Weekly statistics">
                      <div class="card card-outline card-primary mb-0 shadow-sm">
                        <div class="card-header bg-body">
                          <h2 class="card-title fw-bold fs-5 text-primary">Weekly Stats</h2>
                        </div>
                        <div class="card-body p-0">
                          <table class="table table-sm align-middle mb-0">
                            <tbody>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Total Trades</td>
                                <td class="pe-3 py-2 text-end fw-bold" data-stat="totalTrades">0</td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Win / Loss</td>
                                <td class="pe-3 py-2 text-end">
                                  <span class="badge text-bg-success" data-stat="wins">0</span>
                                  <span class="text-secondary mx-1">/</span>
                                  <span class="badge text-bg-danger" data-stat="losses">0</span>
                                </td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Break-even</td>
                                <td class="pe-3 py-2 text-end fw-bold" data-stat="breakEven">0</td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Win Rate</td>
                                <td class="pe-3 py-2" style="width: 55%;">
                                  <div class="d-flex align-items-center justify-content-end gap-2">
                                    <div class="progress progress-xs flex-grow-1">
                                      <div
                                        class="progress-bar bg-success"
                                        id="winrate-progress-bar"
                                        role="progressbar"
                                        style="width: 0%"
                                        aria-valuenow="0"
                                        aria-valuemin="0"
                                        aria-valuemax="100"
                                      ></div>
                                    </div>
                                    <span class="badge text-bg-primary" data-stat="winRate">0.00%</span>
                                  </div>
                                </td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Average Win</td>
                                <td class="pe-3 py-2 text-end fw-bold text-success" data-stat="averageWin">—</td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Average Loss</td>
                                <td class="pe-3 py-2 text-end fw-bold text-danger" data-stat="averageLoss">—</td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Payoff Ratio (R:R)</td>
                                <td class="pe-3 py-2 text-end fw-bold" data-stat="payoffRatio">—</td>
                              </tr>
                              <tr>
                                <td class="ps-3 py-2 text-secondary">Expectancy</td>
                                <td class="pe-3 py-2 text-end fw-bold" data-stat="expectancy">0.00</td>
                              </tr>
                              <tr class="table-light border-top">
                                <td class="ps-3 py-2 fw-bold text-primary">Weekly Net Pips</td>
                                <td class="pe-3 py-2 text-end fw-bold fs-5" data-stat="netPips">0.00</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </aside>
                  </div>
                </section>

              </div>
            </div>
          </div>
        </div>

        <!-- Printable Invoice Container (Export PDF directly without modal dialog) -->
        <div class="d-none d-print-block" id="invoice-print-container">
          <div class="p-4 bg-white text-dark" id="invoice-print-area">
            <!-- Invoice Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge text-bg-primary fs-5 px-3 py-1 fw-bold">TRADING JOURNAL</span>
                  <span class="text-secondary small fw-bold">WEEKLY PERFORMANCE STATEMENT</span>
                </div>
                <h2 class="fs-4 fw-bold mb-1 text-dark" id="inv-account-name">Primary Account</h2>
                <div class="text-secondary small">
                  Trading Period: <strong class="text-dark" id="inv-week-range">19/10/2026 – 25/10/2026</strong>
                </div>
              </div>
              <div class="text-end">
                <div class="text-secondary small">Report ID: <span class="font-monospace fw-semibold" id="inv-id">INV-20261023</span></div>
                <div class="text-secondary small">Export Date: <span id="inv-date">23/10/2026 15:30</span></div>
                <div class="mt-2">
                  <span class="badge px-3 py-2 fs-6 fw-bold" id="inv-status-badge">PROFITABLE</span>
                </div>
              </div>
            </div>

            <!-- 2 Side-by-side Tables (Matching User Request: Strictly WEEKLY TRADES & TRADING STATISTICS) -->
            <div class="row g-4">
              <!-- Weekly Trades Grid Table -->
              <div class="col-12 col-lg-7">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="fw-bold text-uppercase text-secondary small mb-0">
                    <i class="bi bi-table me-1"></i> WEEKLY TRADES
                  </h6>
                  <span class="small text-muted" id="inv-trade-count">0 trades</span>
                </div>
                <div class="table-responsive border rounded">
                  <table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size: 0.88rem;" id="inv-trades-table">
                    <thead class="table-light" id="inv-table-thead">
                      <!-- Dynamically populated header -->
                    </thead>
                    <tbody id="inv-trades-tbody">
                      <!-- Dynamically populated rows -->
                    </tbody>
                    <tfoot class="table-light fw-bold" id="inv-trades-tfoot">
                      <!-- Weekly total -->
                    </tfoot>
                  </table>
                </div>
              </div>

              <!-- Trading Statistics Table -->
              <div class="col-12 col-lg-5">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="fw-bold text-uppercase text-secondary small mb-0">
                    <i class="bi bi-graph-up me-1"></i> TRADING STATISTICS
                  </h6>
                </div>
                <div class="table-responsive border rounded">
                  <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light">
                      <tr>
                        <th scope="col" class="fw-bold">Metric</th>
                        <th scope="col" class="text-end fw-bold" id="inv-stat-week-col">This Week</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>Total Trades</td>
                        <td class="text-end fw-bold" id="inv-stat-trades">0</td>
                      </tr>
                      <tr>
                        <td>Win</td>
                        <td class="text-end text-success fw-bold" id="inv-stat-wins">0</td>
                      </tr>
                      <tr>
                        <td>Loss</td>
                        <td class="text-end text-danger fw-bold" id="inv-stat-losses">0</td>
                      </tr>
                      <tr>
                        <td>Break-even</td>
                        <td class="text-end text-secondary fw-bold" id="inv-stat-be">0</td>
                      </tr>
                      <tr>
                        <td>Average Win</td>
                        <td class="text-end text-success fw-bold" id="inv-stat-avg-win">0.00</td>
                      </tr>
                      <tr>
                        <td>Average Loss</td>
                        <td class="text-end text-danger fw-bold" id="inv-stat-avg-loss">0.00</td>
                      </tr>
                      <tr>
                        <td>Win Rate</td>
                        <td class="text-end fw-bold" id="inv-stat-winrate">0.00%</td>
                      </tr>
                      <tr>
                        <td>Payoff Ratio (R:R)</td>
                        <td class="text-end fw-bold" id="inv-stat-payoff">0.00</td>
                      </tr>
                      <tr>
                        <td>Expectancy</td>
                        <td class="text-end fw-bold" id="inv-stat-expectancy">0.00</td>
                      </tr>
                      <tr class="table-light">
                        <td class="fw-bold">Weekly Net Pips</td>
                        <td class="text-end fw-bold fs-6" id="inv-stat-net">+0.00</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>

    <Scripts path={path} />
    <script src="../scripts/trading-journal.ts"></script>
  </body>
</html>
